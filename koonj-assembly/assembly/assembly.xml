<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>koonj-deployment</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>${deployment.name}</baseDirectory>

    <fileSets>
        <!-- Docker Compose stack & environment template -->
        <fileSet>
            <directory>../deploy/docker</directory>
            <outputDirectory>docker</outputDirectory>
            <includes>
                <include>.env.example</include>
                <include>docker-compose.yml</include>
                <include>docker-compose.otel.yml</include>
                <include>docker-compose.openobserve.yml</include>
            </includes>
            <fileMode>0644</fileMode>
            <lineEnding>unix</lineEnding>
            <useDefaultExcludes>true</useDefaultExcludes>
        </fileSet>

        <!-- Samba gateway configuration & entrypoint -->
        <fileSet>
            <directory>../deploy/samba</directory>
            <outputDirectory>docker/samba</outputDirectory>
            <includes>
                <include>smb.conf</include>
            </includes>
            <fileMode>0644</fileMode>
            <lineEnding>unix</lineEnding>
            <useDefaultExcludes>true</useDefaultExcludes>
        </fileSet>
        <fileSet>
            <directory>../deploy/samba</directory>
            <outputDirectory>docker/samba</outputDirectory>
            <includes>
                <include>start.sh</include>
            </includes>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
            <useDefaultExcludes>true</useDefaultExcludes>
        </fileSet>

        <!-- Keycloak realm, DB init, and login theme -->
        <fileSet>
            <directory>../deploy/keycloak</directory>
            <outputDirectory>docker/keycloak</outputDirectory>
            <includes>
                <include>init-db.sql</include>
                <include>koonj-realm.json</include>
                <include>themes/**</include>
            </includes>
            <excludes>
                <exclude>**/.DS_Store</exclude>
            </excludes>
            <fileMode>0644</fileMode>
            <useDefaultExcludes>true</useDefaultExcludes>
        </fileSet>

        <!-- OpenObserve dashboards -->
        <fileSet>
            <directory>../deploy/openobserve-dashboards</directory>
            <outputDirectory>docker/openobserve-dashboards</outputDirectory>
            <includes>
                <include>*.dashboard.json</include>
            </includes>
            <fileMode>0644</fileMode>
            <lineEnding>unix</lineEnding>
            <useDefaultExcludes>true</useDefaultExcludes>
        </fileSet>

        <!-- Deployment & operational documentation -->
        <fileSet>
            <directory>../docs/guide</directory>
            <outputDirectory>docs/guide</outputDirectory>
            <includes>
                <include>**/*.md</include>
            </includes>
            <fileMode>0644</fileMode>
            <lineEnding>unix</lineEnding>
            <useDefaultExcludes>true</useDefaultExcludes>
        </fileSet>
    </fileSets>

    <files>
        <!-- Dockerfiles for container builds -->
        <file>
            <source>../deploy/docker/koonj-server/Dockerfile</source>
            <outputDirectory>docker/server</outputDirectory>
            <fileMode>0644</fileMode>
            <lineEnding>unix</lineEnding>
        </file>
        <file>
            <source>../deploy/docker/koonj-notification-worker/Dockerfile</source>
            <outputDirectory>docker/notification-worker</outputDirectory>
            <fileMode>0644</fileMode>
            <lineEnding>unix</lineEnding>
        </file>
        <file>
            <source>../deploy/docker/koonj-ui/Dockerfile</source>
            <outputDirectory>docker/ui</outputDirectory>
            <fileMode>0644</fileMode>
            <lineEnding>unix</lineEnding>
        </file>
        <file>
            <source>../deploy/docker/koonj-fuse/Dockerfile</source>
            <outputDirectory>docker/fuse</outputDirectory>
            <fileMode>0644</fileMode>
            <lineEnding>unix</lineEnding>
        </file>

        <!-- Nginx reverse-proxy template for koonj-ui -->
        <file>
            <source>../deploy/docker/nginx/default.conf.template</source>
            <outputDirectory>docker/ui</outputDirectory>
            <fileMode>0644</fileMode>
            <lineEnding>unix</lineEnding>
        </file>

        <!-- Host & client helper scripts -->
        <file>
            <source>../deploy/scripts/fuse/setup-host-mount.sh</source>
            <outputDirectory>docker</outputDirectory>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
        </file>
        <file>
            <source>../deploy/scripts/fuse/run-koonj-fuse.sh</source>
            <outputDirectory>scripts/fuse</outputDirectory>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
        </file>
        <file>
            <source>../deploy/scripts/fuse/run-koonj-fuse.ps1</source>
            <outputDirectory>scripts/fuse</outputDirectory>
            <fileMode>0644</fileMode>
            <lineEnding>dos</lineEnding>
        </file>
        <file>
            <source>../deploy/scripts/mcp/mcp-bridge.mjs</source>
            <outputDirectory>docker/mcp</outputDirectory>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
        </file>

        <!-- Keycloak theme branding assets -->
        <file>
            <source>../koonj-ui/public/img/atm-banner-16x9-clean.jpg</source>
            <outputDirectory>docker/keycloak/themes/koonj/login/resources/img</outputDirectory>
            <fileMode>0644</fileMode>
        </file>
        <file>
            <source>../koonj-ui/public/img/koonj-mark.svg</source>
            <outputDirectory>docker/keycloak/themes/koonj/login/resources/img</outputDirectory>
            <fileMode>0644</fileMode>
        </file>
        <file>
            <source>../koonj-ui/public/favicon.ico</source>
            <outputDirectory>docker/keycloak/themes/koonj/login/resources/img</outputDirectory>
            <fileMode>0644</fileMode>
        </file>
    </files>

    <dependencySets>
        <dependencySet>
            <outputDirectory>docker/notification-worker</outputDirectory>
            <includes>
                <include>uk.appsthatmatter:koonj-notification-worker</include>
            </includes>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <useStrictFiltering>true</useStrictFiltering>
            <outputFileNameMapping>koonj-notification-worker.jar</outputFileNameMapping>
        </dependencySet>
        <dependencySet>
            <outputDirectory>docker/server</outputDirectory>
            <includes>
                <include>uk.appsthatmatter:koonj-server</include>
            </includes>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <useStrictFiltering>true</useStrictFiltering>
            <outputFileNameMapping>koonj-server.jar</outputFileNameMapping>
        </dependencySet>
        <dependencySet>
            <outputDirectory>docker/fuse</outputDirectory>
            <includes>
                <include>uk.appsthatmatter:koonj-fuse</include>
            </includes>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <useStrictFiltering>true</useStrictFiltering>
            <outputFileNameMapping>koonj-fuse.jar</outputFileNameMapping>
        </dependencySet>
        <dependencySet>
            <outputDirectory>docker/ui</outputDirectory>
            <includes>
                <include>uk.appsthatmatter:koonj-ui:zip:web</include>
            </includes>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <useStrictFiltering>true</useStrictFiltering>
            <unpack>true</unpack>
        </dependencySet>
    </dependencySets>
</assembly>
