<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>deployment</id>
    <formats>
        <format>zip</format>
    </formats>
    <baseDirectory>${deployment.name}</baseDirectory>

    <fileSets>
        <fileSet>
            <directory>../deploy/production/docker</directory>
            <outputDirectory>docker</outputDirectory>
            <includes>
                <include>.env.example</include>
                <include>docker-compose.yml</include>
                <include>docker-compose.otel.yml</include>
                <include>openobserve.compose.yml</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>../deploy/keycloak</directory>
            <outputDirectory>docker/keycloak</outputDirectory>
            <includes>
                <include>init-db.sql</include>
                <include>koonj-realm.json</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>../deploy/production/on-premise</directory>
            <outputDirectory>on-premise</outputDirectory>
            <includes>
                <include>install.sh</include>
                <include>bin/koonj-server.sh</include>
            </includes>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
        </fileSet>
        <fileSet>
            <directory>../deploy/production/on-premise</directory>
            <outputDirectory>on-premise</outputDirectory>
            <includes>
                <include>install.cmd</include>
                <include>bin/koonj-server.cmd</include>
            </includes>
            <lineEnding>dos</lineEnding>
        </fileSet>
        <fileSet>
            <directory>../deploy/production/on-premise</directory>
            <outputDirectory>on-premise</outputDirectory>
            <includes>
                <include>config/application-production.yml</include>
                <include>nginx/koonj.conf</include>
                <include>systemd/koonj-server.service</include>
            </includes>
            <lineEnding>unix</lineEnding>
        </fileSet>
    </fileSets>

    <files>
        <file>
            <source>../docs/DEPLOYMENT-GUIDE.md</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <file>
            <source>../deploy/production/docker/Dockerfile.server</source>
            <outputDirectory>docker/server</outputDirectory>
        </file>
        <file>
            <source>../deploy/production/docker/Dockerfile.ui</source>
            <outputDirectory>docker/ui</outputDirectory>
        </file>
        <file>
            <source>../deploy/production/docker/nginx/default.conf.template</source>
            <outputDirectory>docker/ui</outputDirectory>
            <lineEnding>unix</lineEnding>
        </file>
        <file>
            <source>../deploy/production/on-premise/config/koonj.env.example</source>
            <outputDirectory>on-premise/config</outputDirectory>
            <destName>koonj.env</destName>
            <lineEnding>unix</lineEnding>
        </file>
        <file>
            <source>../deploy/keycloak/koonj-realm.json</source>
            <outputDirectory>on-premise/keycloak</outputDirectory>
        </file>
    </files>

    <dependencySets>
        <dependencySet>
            <outputDirectory>docker/server</outputDirectory>
            <includes>
                <include>uk.appsthatmatter:koonj-server</include>
            </includes>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <useStrictFiltering>true</useStrictFiltering>
            <outputFileNameMapping>koonj-server.jar</outputFileNameMapping>
        </dependencySet>
        <dependencySet>
            <outputDirectory>on-premise/lib</outputDirectory>
            <includes>
                <include>uk.appsthatmatter:koonj-server</include>
            </includes>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <useStrictFiltering>true</useStrictFiltering>
            <outputFileNameMapping>koonj-server.jar</outputFileNameMapping>
        </dependencySet>
        <dependencySet>
            <outputDirectory>docker/ui</outputDirectory>
            <includes>
                <include>uk.appsthatmatter:koonj-ui:zip:web</include>
            </includes>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <useStrictFiltering>true</useStrictFiltering>
            <unpack>true</unpack>
        </dependencySet>
        <dependencySet>
            <outputDirectory>on-premise/web</outputDirectory>
            <includes>
                <include>uk.appsthatmatter:koonj-ui:zip:web</include>
            </includes>
            <useProjectArtifact>false</useProjectArtifact>
            <useTransitiveDependencies>false</useTransitiveDependencies>
            <useStrictFiltering>true</useStrictFiltering>
            <unpack>true</unpack>
        </dependencySet>
    </dependencySets>
</assembly>
