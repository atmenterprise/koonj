[Unit]
Description=Koonj notification worker
After=network-online.target postgresql.service koonj-server.service
Wants=network-online.target

[Service]
Type=exec
User=koonj
Group=koonj
WorkingDirectory=/opt/koonj
EnvironmentFile=/opt/koonj/config/koonj.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=70.0 -jar /opt/koonj/lib/koonj-notification-worker.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
