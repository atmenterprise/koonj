# =============================================================================
# Koonj — On-Premise Environment Configuration
# =============================================================================
# Copy to /opt/koonj/config/koonj.env — edit all CHANGE_ME values.
# Sourced by koonj-server.sh and the systemd unit.
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
KOONJ_DB_URL=jdbc:postgresql://localhost:5432/koonj?reWriteBatchedInserts=true
KOONJ_DB_USERNAME=koonj
KOONJ_DB_PASSWORD=CHANGE_ME
KOONJ_DDL_AUTO=update
KOONJ_DB_POOL_SIZE=20

# ── Keycloak ─────────────────────────────────────────────────────────────────
KOONJ_AUTH_ISSUER_URI=http://localhost:8180/realms/koonj
KOONJ_AUTH_JWK_SET_URI=http://localhost:8180/realms/koonj/protocol/openid-connect/certs

# ── CORS ─────────────────────────────────────────────────────────────────────
KOONJ_CORS_ALLOWED_ORIGINS=http://localhost

# ── Server ───────────────────────────────────────────────────────────────────
KOONJ_SERVER_PORT=8080
KOONJ_MAX_THREADS=200
SPRING_PROFILES_ACTIVE=production

# ── JVM ──────────────────────────────────────────────────────────────────────
JAVA_OPTS="-Xms512m -Xmx2g -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom"

# ── Optional: HTTP Basic Auth ────────────────────────────────────────────────
KOONJ_BASIC_AUTH_ENABLED=false
KOONJ_BASIC_AUTH_USERNAME=
KOONJ_BASIC_AUTH_PASSWORD=
KOONJ_BASIC_AUTH_ROLE=KOONJ_VIEWER

# ── Logging ──────────────────────────────────────────────────────────────────
KOONJ_LOG_FILE=/opt/koonj/logs/koonj-server.log

# ── OpenObserve (optional OTLP metrics) ─────────────────────────────────────
MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=false
MANAGEMENT_OTLP_METRICS_EXPORT_URL=http://localhost:5080/api/default/v1/metrics
# Set to "Basic <base64(email:password)>" when export is enabled.
OPENOBSERVE_AUTHORIZATION=
