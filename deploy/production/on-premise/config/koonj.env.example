# =============================================================================
# Koonj — On-Premise Environment Configuration
# =============================================================================
# Copy to /opt/koonj/config/koonj.env — edit all CHANGE_ME values.
# Sourced by koonj-server.sh and the systemd unit.
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
KOONJ_DB_URL=jdbc:postgresql://localhost:5432/koonj?reWriteBatchedInserts=true
KOONJ_DB_USERNAME=koonj
KOONJ_DB_PASSWORD=CHANGE_ME
KOONJ_DDL_AUTO=update
KOONJ_DB_POOL_SIZE=20

# ── Keycloak ─────────────────────────────────────────────────────────────────
KOONJ_AUTH_ISSUER_URI=http://localhost:8180/realms/koonj
KOONJ_AUTH_JWK_SET_URI=http://localhost:8180/realms/koonj/protocol/openid-connect/certs

# Project migration access and permitted FUSE agent projects
KOONJ_PROJECTS_LEGACY_SUBJECTS=
KOONJ_PROJECTS_AGENT_IDS=00000000-0000-0000-0000-000000000001

# ── CORS ─────────────────────────────────────────────────────────────────────
KOONJ_CORS_ALLOWED_ORIGINS=http://localhost

# ── Server ───────────────────────────────────────────────────────────────────
KOONJ_SERVER_PORT=8080
KOONJ_MAX_THREADS=200
SPRING_PROFILES_ACTIVE=production

# ── JVM ──────────────────────────────────────────────────────────────────────
JAVA_OPTS="-Xms512m -Xmx2g -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom"

# ── Optional: HTTP Basic Auth ────────────────────────────────────────────────
KOONJ_BASIC_AUTH_ENABLED=false
KOONJ_BASIC_AUTH_USERNAME=
KOONJ_BASIC_AUTH_PASSWORD=
KOONJ_BASIC_AUTH_ROLE=KOONJ_VIEWER

# ── Logging ──────────────────────────────────────────────────────────────────
KOONJ_LOG_LEVEL=INFO
# Optional rolling file on a writable local or shared mount.
KOONJ_LOG_FILE=

# ── OpenObserve (optional dashboards and OTLP signals) ─────────────────────
KOONJ_OPENOBSERVE_URL=
KOONJ_OPENOBSERVE_ORGANIZATION=default
# Set to https://observe.example.com/api/default/dashboards to import at startup.
KOONJ_OPENOBSERVE_DASHBOARDS_ENDPOINT=
# Optional separate authorization with permission to list and create dashboards.
# KOONJ_OPENOBSERVE_DASHBOARDS_AUTHORIZATION="Basic <base64(email:password)>"
KOONJ_OTLP_LOGS_ENDPOINT=
MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=false
MANAGEMENT_OTLP_METRICS_EXPORT_URL=http://localhost:5080/api/default/v1/metrics
MANAGEMENT_OTLP_TRACING_EXPORT_ENABLED=false
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:5080/api/default/v1/traces
# Set to "Basic <base64(email:password)>" when export is enabled.
OPENOBSERVE_AUTHORIZATION=

# SMTP defaults. SMTP channels can override these settings in Administration.
KOONJ_MAIL_HOST=
KOONJ_MAIL_PORT=587
KOONJ_MAIL_USERNAME=
KOONJ_MAIL_PASSWORD=
KOONJ_MAIL_FROM=
KOONJ_MAIL_TLS=STARTTLS
KOONJ_MAIL_TIMEOUT=10s


# Outbound webhook requests. Retry delay doubles after each failed attempt.
KOONJ_WEBHOOK_CONNECT_TIMEOUT=5s
KOONJ_WEBHOOK_REQUEST_TIMEOUT=10s
KOONJ_WEBHOOK_MAX_ATTEMPTS=3
KOONJ_WEBHOOK_RETRY_DELAY=1s


# Quota limits (0 disables the corresponding check). License dates use ISO 8601 UTC.
KOONJ_QUOTA_CATALOGED_FILES=0
KOONJ_QUOTA_STORAGE_CONNECTIONS=0
KOONJ_QUOTA_TRANSFER_CONCURRENCY=0
KOONJ_LICENSE_EXPIRES_AT=
KOONJ_LICENSE_GRACE_ENDS_AT=
KOONJ_NOTIFICATION_LIMIT_CHECK_INTERVAL=1m

# Shared RabbitMQ broker (the notification worker uses the koonj virtual host).
KOONJ_RABBITMQ_HOST=localhost
KOONJ_RABBITMQ_PORT=5672
KOONJ_RABBITMQ_USERNAME=koonj
KOONJ_RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ
KOONJ_RABBITMQ_VHOST=koonj
KOONJ_RABBITMQ_SSL=false

# Enable RabbitMQ transfer dispatch before running multiple server instances.
KOONJ_TRANSFER_RABBIT_ENABLED=false
KOONJ_TRANSFER_WORKER_ENABLED=true
KOONJ_TRANSFER_RELAY_ENABLED=true
KOONJ_TRANSFER_WORKER_POOL=default

# Notification worker settings.
KOONJ_NOTIFICATION_DB_POOL_SIZE=4
KOONJ_NOTIFICATION_EMAIL_CONCURRENCY=2
KOONJ_NOTIFICATION_WEBHOOK_CONCURRENCY=2
KOONJ_NOTIFICATION_POLL_INTERVAL=1s
KOONJ_MAIL_MAX_ATTEMPTS=3
KOONJ_MAIL_RETRY_DELAY=30s
