# =============================================================================
# Koonj Server — Production Dockerfile
# =============================================================================
# This Dockerfile expects the pre-built JAR to be in the build context:
#   docker build -f Dockerfile.server -t koonj-server .
#
# The JAR is copied from the build.sh output — no source compilation here,
# keeping customer images lean and reproducible.
# =============================================================================
FROM eclipse-temurin:21-jre-alpine

LABEL maintainer="Koonj <support@appsthatmatter.uk>"
LABEL org.opencontainers.image.title="koonj-server"
LABEL org.opencontainers.image.description="Koonj Data Catalog API Server"

# ── Security: run as non-root ────────────────────────────────────────────────
RUN addgroup -S koonj && adduser -S -G koonj -h /opt/koonj koonj

# ── Runtime dependencies ────────────────────────────────────────────────────
RUN apk add --no-cache curl tini

# ── Application layout ──────────────────────────────────────────────────────
WORKDIR /opt/koonj
COPY koonj-server.jar /opt/koonj/app.jar

# Download OpenTelemetry Java Auto-Instrumentation Agent
ARG OTEL_AGENT_VERSION=2.13.3
ADD https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_AGENT_VERSION}/opentelemetry-javaagent.jar /opt/koonj/opentelemetry-javaagent.jar
RUN chmod 644 /opt/koonj/opentelemetry-javaagent.jar && chown -R koonj:koonj /opt/koonj

# ── JVM tuning (container-aware defaults) ────────────────────────────────────
ENV JAVA_OPTS="-XX:+UseContainerSupport \
  -XX:MaxRAMPercentage=75.0 \
  -XX:InitialRAMPercentage=50.0 \
  -Djava.security.egd=file:/dev/./urandom"

# ── OpenTelemetry Agent Defaults ─────────────────────────────────────────────
# Set OTEL_JAVAAGENT_ENABLED=true in container/compose to activate
ENV OTEL_JAVAAGENT_ENABLED="false" \
    OTEL_SERVICE_NAME="koonj-server" \
    OTEL_EXPORTER_OTLP_PROTOCOL="grpc" \
    OTEL_METRICS_EXPORTER="none" \
    OTEL_LOGS_EXPORTER="none"

# ── Spring Boot configuration via environment ───────────────────────────────
# All config is injected through environment variables.
# See .env.example for the full list.
ENV SPRING_PROFILES_ACTIVE="production"

EXPOSE 8080

USER koonj

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -sf http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["sh", "-c", "if [ \"${OTEL_JAVAAGENT_ENABLED}\" = \"true\" ]; then OTEL_ARG=\"-javaagent:/opt/koonj/opentelemetry-javaagent.jar\"; else OTEL_ARG=\"\"; fi; exec java ${JAVA_OPTS} ${OTEL_ARG} -jar /opt/koonj/app.jar"]
