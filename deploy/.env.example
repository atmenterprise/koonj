# Linux host directories. Run scripts/setup-host-mount.sh before enabling the gateway.
KOONJ_FUSE_BACKING_DIR=/srv/koonj/backing
KOONJ_FUSE_MOUNT_POINT=/srv/koonj/share
KOONJ_FUSE_ALLOW_OTHER=true

# Required for the fuse and smb profiles. Use the Keycloak agent client secret.
KOONJ_AGENT_CLIENT_ID=koonj-agent
KOONJ_AGENT_CLIENT_SECRET=
KOONJ_AGENT_TOKEN_URI=http://keycloak:8080/realms/koonj/protocol/openid-connect/token
KOONJ_SERVER_URL=http://host.docker.internal:8080

# Optional smb profile. The SMB account is koonj. Set a separate password.
# Use the gateway's LAN address to allow connections from other machines.
KOONJ_SMB_BIND=127.0.0.1
KOONJ_SMB_PORT=445
KOONJ_SMB_PASSWORD=
