# =============================================================================
# Koonj — Docker Deployment Environment Variables
# =============================================================================
# Copy this file to .env and customise values before first deployment.
#
#   cp .env.example .env
#   $EDITOR .env
#   docker compose up -d --build --wait
#
# REQUIRED fields are marked — the deployment will not start without them.
# =============================================================================

# ── Version tag ──────────────────────────────────────────────────────────────
KOONJ_VERSION=latest

# ── PostgreSQL ───────────────────────────────────────────────────────────────
KOONJ_DB_NAME=koonj
KOONJ_DB_USERNAME=koonj
KOONJ_DB_PASSWORD=CHANGE_ME_koonj_db_password       # REQUIRED
KOONJ_DDL_AUTO=update
KOONJ_PG_PORT=5432
KOONJ_PG_BIND=127.0.0.1

# ── Keycloak (Identity & Access Management) ──────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin     # REQUIRED
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db           # REQUIRED
KOONJ_KEYCLOAK_PORT=8180
KOONJ_KEYCLOAK_BIND=127.0.0.1

# REQUIRED: The external URL customers use to reach Keycloak.
# Used for token issuer validation. Must be accessible from both
# the browser and the koonj-server container.
# Examples: https://auth.example.com  or  http://10.0.0.5:8180
KOONJ_KEYCLOAK_EXTERNAL_URL=http://localhost:8180

# ── UI / Server Ports & CORS ─────────────────────────────────────────────────
KOONJ_UI_PORT=80
KOONJ_UI_BIND=0.0.0.0
KOONJ_PUBLIC_UI_URL=
KOONJ_CORS_ALLOWED_ORIGINS=http://localhost

# ── Koonj Server & Logging ───────────────────────────────────────────────────
KOONJ_SERVER_MEMORY=2G
KOONJ_LOG_LEVEL=INFO
# Set to container paths on a writable mount to enable rolling files.
KOONJ_LOG_FILE=
KOONJ_TRANSFER_WORKER_LOG_FILE=

# Optional: HTTP Basic Auth for legacy script integration
KOONJ_BASIC_AUTH_ENABLED=false
KOONJ_BASIC_AUTH_USERNAME=
KOONJ_BASIC_AUTH_PASSWORD=
KOONJ_BASIC_AUTH_ROLE=KOONJ_VIEWER

# ── Quota & Licensing ────────────────────────────────────────────────────────
# Set to 0 to disable the corresponding quota check. License dates use ISO 8601 UTC.
KOONJ_QUOTA_CATALOGED_FILES=0
KOONJ_QUOTA_STORAGE_CONNECTIONS=0
KOONJ_QUOTA_TRANSFER_CONCURRENCY=0
KOONJ_LICENSE_EXPIRES_AT=
KOONJ_LICENSE_GRACE_ENDS_AT=
KOONJ_NOTIFICATION_LIMIT_CHECK_INTERVAL=1m

# ── RabbitMQ (Shared Broker) ─────────────────────────────────────────────────
# The notification worker uses the koonj virtual host.
KOONJ_RABBITMQ_HOST=rabbitmq
KOONJ_RABBITMQ_PORT=5672
KOONJ_RABBITMQ_USERNAME=koonj
KOONJ_RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ
KOONJ_RABBITMQ_VHOST=koonj
KOONJ_RABBITMQ_SSL=false

# ── Transfer Dispatch & Worker ───────────────────────────────────────────────
KOONJ_TRANSFER_WORKER_POOL=default
KOONJ_TRANSFER_BACKGROUND_WORKERS=2
KOONJ_TRANSFER_INTERACTIVE_WORKERS=1
KOONJ_TRANSFER_TENANT_JOBS=2
KOONJ_TRANSFER_TENANT_INTERACTIVE_JOBS=1
KOONJ_TRANSFER_BACKEND_JOBS=8
KOONJ_TRANSFER_CASE_INSENSITIVE_MOUNTS=true
KOONJ_TRANSFER_MOUNTED_DOMAIN=default
# Optional mount routes and aliases. See the transfer worker guide.
KOONJ_TRANSFER_MOUNT_POOLS=
KOONJ_TRANSFER_STORAGE_ALIASES=
# Optional RabbitMQ overrides for transfer dispatch (defaults to KOONJ_RABBITMQ_*).
KOONJ_TRANSFER_RABBIT_HOST=
KOONJ_TRANSFER_RABBIT_PORT=
KOONJ_TRANSFER_RABBIT_USERNAME=
KOONJ_TRANSFER_RABBIT_PASSWORD=
KOONJ_TRANSFER_RABBIT_VHOST=
KOONJ_TRANSFER_RABBIT_SSL=

# ── Notification Worker, SMTP & Webhooks ─────────────────────────────────────
KOONJ_NOTIFICATION_WORKER_MEMORY=512M
KOONJ_NOTIFICATION_DB_POOL_SIZE=4
KOONJ_NOTIFICATION_EMAIL_CONCURRENCY=2
KOONJ_NOTIFICATION_WEBHOOK_CONCURRENCY=2
KOONJ_NOTIFICATION_POLL_INTERVAL=1s

# SMTP defaults. SMTP channels can override these settings in Administration.
KOONJ_MAIL_HOST=
KOONJ_MAIL_PORT=587
KOONJ_MAIL_USERNAME=
KOONJ_MAIL_PASSWORD=
KOONJ_MAIL_FROM=
KOONJ_MAIL_TLS=STARTTLS
KOONJ_MAIL_TIMEOUT=10s
KOONJ_MAIL_MAX_ATTEMPTS=3
KOONJ_MAIL_RETRY_DELAY=30s

# Outbound webhook requests. Retry delay doubles after each failed attempt.
KOONJ_WEBHOOK_CONNECT_TIMEOUT=5s
KOONJ_WEBHOOK_REQUEST_TIMEOUT=10s
KOONJ_WEBHOOK_MAX_ATTEMPTS=3
KOONJ_WEBHOOK_RETRY_DELAY=1s

# ── Data Mount, FUSE Gateway & Agent ─────────────────────────────────────────
# Host path mounted into koonj-server for local/NAS file access.
# Use an absolute path to the directory containing files to catalog.
KOONJ_DATA_MOUNT=./data

# Optional centralized FUSE gateway. For the gateway defaults, set KOONJ_DATA_MOUNT
# to /srv/koonj/backing. When set, KOONJ_DATA_MOUNT takes precedence for both services.
KOONJ_FUSE_BACKING_DIR=/srv/koonj/backing
KOONJ_FUSE_MOUNT_POINT=/srv/koonj/share
KOONJ_FUSE_ALLOW_OTHER=true
# Optional local FUSE JAR path (used when running FUSE agent directly on host/macOS).
KOONJ_FUSE_JAR=

KOONJ_AGENT_CLIENT_ID=koonj-agent
KOONJ_AGENT_CLIENT_SECRET=
KOONJ_AGENT_TOKEN_URI=http://keycloak:8080/realms/koonj/protocol/openid-connect/token
KOONJ_AGENT_PROJECT_ID=
KOONJ_PROJECTS_AGENT_IDS=00000000-0000-0000-0000-000000000001

# ── SMB Gateway (Optional smb profile) ───────────────────────────────────────
# Use the gateway LAN address for remote client access.
KOONJ_SMB_BIND=127.0.0.1
KOONJ_SMB_PORT=445
KOONJ_SMB_PASSWORD=

# ── Storage Authentication & Key Management ──────────────────────────────────
# Use a workload role for AWS access. In shared SaaS deployments set
# KOONJ_AWS_ALLOW_DEFAULT_CHAIN=false and use customer IAM roles.
KOONJ_STORAGE_SECRET_CACHE_TTL=PT30S
KOONJ_STORAGE_ALLOW_INSECURE_ENDPOINTS=false
KOONJ_AWS_ALLOW_DEFAULT_CHAIN=true
# Generate a UUID once per deployment, share it across replicas and back it up.
KOONJ_AWS_EXTERNAL_ID_NAMESPACE=
# Enable aws-sm: secret references by setting the Secrets Manager region.
KOONJ_AWS_SECRETS_REGION=

# PostgreSQL stores credential envelopes. AWS KMS is recommended for shared deployments.
KOONJ_STORAGE_KEY_PROVIDER=disabled
KOONJ_STORAGE_KMS_KEY_ARN=
# Comma-separated full key ARNs retained for decrypting existing envelopes and backups.
KOONJ_STORAGE_KMS_PREVIOUS_KEY_ARNS=
# Local provider for disconnected deployments. Inject the keyring securely at runtime.
# Format: key-id:base64-32-byte-key[,older-id:base64-key]
KOONJ_STORAGE_LOCAL_ACTIVE_KEY=
KOONJ_STORAGE_LOCAL_KEYS=

# ── OpenObserve & OpenTelemetry ────────────────────
OPENOBSERVE_ROOT_EMAIL=
OPENOBSERVE_ROOT_PASSWORD=
# Format: Basic <base64(email:password)>
OPENOBSERVE_AUTHORIZATION=
# Optional separate authorization with permission to list and create dashboards
# (defaults to OPENOBSERVE_AUTHORIZATION when empty).
KOONJ_OPENOBSERVE_DASHBOARDS_AUTHORIZATION=
OPENOBSERVE_BIND=127.0.0.1
OPENOBSERVE_PORT=5080
# Defaults to http://localhost:${OPENOBSERVE_PORT:-5080}/web when empty.
KOONJ_OPENOBSERVE_URL=
KOONJ_OPENOBSERVE_ORGANIZATION=default
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
