{
  "version": 8,
  "dashboardId": "koonj-server-logs",
  "title": "Koonj | Server Logs",
  "description": "Application log volume, severity, and recent failures for the API and transfer worker.",
  "role": "",
  "owner": "",
  "created": "2025-01-01T00:00:00.000Z",
  "tabs": [
    {
      "tabId": "overview",
      "name": "Overview",
      "panels": [
        {
          "id": "severity-volume",
          "type": "bar",
          "title": "Log volume by severity",
          "description": "Includes DETAIL and DEBUG whenever those levels are enabled.",
          "config": {
            "show_legends": true,
            "legends_position": "bottom",
            "unit": "short",
            "decimals": 0,
            "connect_nulls": false,
            "show_symbol": false,
            "table_pagination": true,
            "table_pagination_rows_per_page": 10
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS bucket, severity, count(*) AS records FROM \"koonj_server\" WHERE service_name = 'koonj-server' GROUP BY bucket, severity ORDER BY bucket",
              "customQuery": true,
              "fields": {
                "stream": "koonj_server",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Time",
                    "alias": "bucket",
                    "column": "bucket",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Log records",
                    "alias": "records",
                    "column": "records",
                    "color": null
                  }
                ],
                "z": [],
                "breakdown": [
                  {
                    "label": "Severity",
                    "alias": "severity",
                    "column": "severity",
                    "color": null
                  }
                ],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1,
                "time_shift": []
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 96,
            "h": 10,
            "i": 1
          }
        },
        {
          "id": "error-loggers",
          "type": "bar",
          "title": "Errors by logger",
          "description": "Counts ERROR and higher-severity log records by source class.",
          "config": {
            "show_legends": true,
            "legends_position": "bottom",
            "unit": "short",
            "decimals": 0,
            "connect_nulls": false,
            "show_symbol": false,
            "table_pagination": true,
            "table_pagination_rows_per_page": 10
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT logger_name, count(*) AS records FROM \"koonj_server\" WHERE service_name = 'koonj-server' AND severity_number >= 17 GROUP BY logger_name ORDER BY records DESC LIMIT 15",
              "customQuery": true,
              "fields": {
                "stream": "koonj_server",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Logger",
                    "alias": "logger_name",
                    "column": "logger_name",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Errors",
                    "alias": "records",
                    "column": "records",
                    "color": null
                  }
                ],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1,
                "time_shift": []
              }
            }
          ],
          "layout": {
            "x": 96,
            "y": 0,
            "w": 96,
            "h": 10,
            "i": 2
          }
        },
        {
          "id": "recent-failures",
          "type": "table",
