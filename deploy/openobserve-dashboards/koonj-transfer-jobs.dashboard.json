        {
          "id": "job-outcomes",
          "type": "line",
          "title": "Job executions per minute",
          "description": "Five-minute rolling rate of execution attempts, grouped by outcome. Resumes and deferred restores can create additional attempts.",
          "config": {
            "show_legends": true,
            "legends_position": "bottom",
            "unit": "short",
            "decimals": 2,
            "connect_nulls": false,
            "show_symbol": false,
            "table_pagination": true,
            "table_pagination_rows_per_page": 10
          },
          "queryType": "promql",
          "queries": [
            {
              "query": "60 * sum by (outcome) (rate(koonj_job_execution_count{application=\"koonj-server\"}[5m]))",
              "customQuery": true,
              "fields": {
                "stream": "koonj_job_execution_count",
                "stream_type": "metrics",
                "x": [],
                "y": [],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "{outcome}",
                "layer_type": "scatter",
                "weight_fixed": 1,
                "time_shift": []
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 96,
            "h": 10,
            "i": 1
          }
        },
        {
          "id": "job-p95",
          "type": "line",
          "title": "Job p95 duration (seconds)",
          "description": "95th-percentile span duration by operation, including any recorded outcome.",
          "config": {
            "show_legends": true,
            "legends_position": "bottom",
            "unit": "seconds",
            "decimals": 0,
            "connect_nulls": false,
            "show_symbol": false,
            "table_pagination": true,
            "table_pagination_rows_per_page": 10
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS bucket, operation, approx_percentile_cont(duration, 0.95) / 1000000.0 AS seconds FROM \"default\" WHERE service_name = 'koonj-server' AND operation_name = 'koonj.job.execution' GROUP BY bucket, operation ORDER BY bucket",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [
                  {
                    "label": "Time",
                    "alias": "bucket",
                    "column": "bucket",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "p95 seconds",
                    "alias": "seconds",
                    "column": "seconds",
                    "color": null
                  }
                ],
                "z": [],
                "breakdown": [
                  {
                    "label": "Operation",
                    "alias": "operation",
                    "column": "operation",
                    "color": null
                  }
                ],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1,
                "time_shift": []
              }
            }
          ],
          "layout": {
            "x": 96,
            "y": 0,
            "w": 96,
            "h": 10,
            "i": 2
          }
        },
