        {
          "id": "failed-spans",
          "type": "table",
          "title": "Recent failed job spans",
          "description": "Use a trace ID in OpenObserve Traces to inspect an execution attempt.",
          "config": {
            "show_legends": false,
            "legends_position": "bottom",
            "unit": "short",
            "decimals": 0,
            "connect_nulls": false,
            "show_symbol": false,
            "table_pagination": true,
            "table_pagination_rows_per_page": 10
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT _timestamp, operation, outcome, ROUND(duration / 1000.0) AS duration_ms, trace_id FROM \"default\" WHERE service_name = 'koonj-server' AND operation_name = 'koonj.job.execution' AND outcome IN ('FAILED', 'PARTIAL_FAILURE') ORDER BY _timestamp DESC LIMIT 50",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [
